# WeatherGPT Environment Configuration

# OpenAI API Key (Required for AI endpoints /ask, /understand, /ai-test)
OPENAI_API_KEY=your_openai_api_key_here

# Weather Provider Configuration
# Active MVP Provider: open_meteo (default, no API key required)
# Future / Optional Provider: imd (requires official IMD credentials)
WEATHER_PROVIDER=open_meteo

# Future IMD API Configuration (Optional - not required for MVP)
# IMD_API_KEY=your_imd_api_key_here
# IMD_BASE_URL=https://api.imd.gov.in
