# WeatherGPT Environment Configuration

# ── AI Engine ──────────────────────────────────────────────────────────────
# Google Gemini 2.5 Flash (Primary AI — get key at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional fallback)
# OPENAI_API_KEY=your_openai_api_key_here

# ── Weather Providers ──────────────────────────────────────────────────────
# Options: tomorrow_io (default, richest data) | open_meteo (free, no key) | imd
WEATHER_PROVIDER=tomorrow_io

# Tomorrow.io API Key (default provider — free tier at tomorrow.io)
TOMORROW_IO_API_KEY=i5LJno7krOwQzcnRCcl6hwuRakcdHFMW

# Open-Meteo: No key needed — used as fallback when WEATHER_PROVIDER=open_meteo
# IMD (India Meteorological Dept — optional, requires official credentials)
# IMD_API_KEY=your_imd_api_key_here
# IMD_BASE_URL=https://api.imd.gov.in
